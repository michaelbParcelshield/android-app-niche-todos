<?xml version="1.0" encoding="utf-8"?>
<!-- ABOUTME: Layout for individual todo item in RecyclerView -->
<!-- Contains checkbox for completion, todo text, and edit/delete/subtask buttons -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="0dp"
    app:cardCornerRadius="0dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardUseCompatPadding="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:foreground="?attr/selectableItemBackground">

        <View
            android:id="@+id/view_nesting_bar"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:alpha="0.55"
            android:background="?attr/colorOutline"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/button_toggle_collapse"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="2dp"
            android:contentDescription="@string/content_desc_expand_todo"
            android:src="@drawable/ic_expand_more"
            android:tint="?attr/colorOnSurfaceVariant"
            app:layout_constraintStart_toEndOf="@id/view_nesting_bar"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <CheckBox
            android:id="@+id/checkbox_completed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/content_desc_mark_complete"
            android:minWidth="36dp"
            android:minHeight="36dp"
            app:layout_constraintStart_toEndOf="@id/button_toggle_collapse"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/text_todo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            android:maxLines="1"
            android:textStyle="bold"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/checkbox_completed"
            app:layout_constraintEnd_toStartOf="@id/button_more"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/text_start_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="2dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:alpha="0.9"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/checkbox_completed"
            app:layout_constraintEnd_toStartOf="@id/button_more"
            app:layout_constraintTop_toBottomOf="@id/text_todo" />

        <TextView
            android:id="@+id/text_end_date"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/checkbox_completed"
            app:layout_constraintEnd_toStartOf="@id/button_more"
            app:layout_constraintTop_toBottomOf="@id/text_start_date"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageButton
            android:id="@+id/button_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/content_desc_more_actions"
            android:minWidth="36dp"
            android:minHeight="36dp"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_more"
            android:tint="?attr/colorOnSurfaceVariant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <View
            android:id="@+id/view_nested_divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:alpha="0.35"
            android:background="?attr/colorOutline"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/text_todo" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
